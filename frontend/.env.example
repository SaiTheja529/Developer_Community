# Leave empty in dev to call same-origin /api through the Vite proxy (works on any port).
# Set to the API origin in production, e.g. https://api.devcommons.app
VITE_API_BASE_URL=
VITE_APP_NAME=DevCommons

# Dev proxy (not exposed to the browser): where Flask runs, and an Origin its CORS_ORIGINS allows.
DEV_API_TARGET=http://localhost:5001
DEV_API_ORIGIN=http://localhost:5173
