# ---------------------------------------------------------------------------
# DevCommons backend configuration. Copy to .env and fill in the values.
# Generate secrets with:   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
APP_NAME=DevCommons
SECRET_KEY=change-me-to-64-random-characters-change-me-to-64-random-characters
DATABASE_URL=postgresql+psycopg://devcommons:devcommons@localhost:5433/devcommons
DB_POOL_SIZE=5
# comma-separated frontend origins (never *)
CORS_ORIGINS=http://localhost:5173

# --- Auth / JWT (spec §6) ---------------------------------------------------
JWT_SIGNING_KEYS={"2026-11":"REPLACE_WITH_BASE64_32_BYTES"}
JWT_ACTIVE_KID=2026-11
JWT_ISSUER=devcommons-api
JWT_AUDIENCE=devcommons-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
REFRESH_COOKIE_NAME=dc_refresh
# true in production (https)
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# --- Email --------------------------------------------------------------------
# console = print emails in this terminal (no real email). smtp = send real email.
EMAIL_PROVIDER=console
# With Gmail, use the same address as SMTP_USERNAME (Gmail rewrites other senders).
EMAIL_FROM=DevCommons <no-reply@devcommons.app>
# SMTP settings, used only when EMAIL_PROVIDER=smtp. Example for Gmail (needs an App Password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587) | ssl (465) | none (local test server only)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15

# --- Sign in with GitHub / Google (optional) ---------------------------------
# A provider's button appears once both its ID and secret are set. Restart after changing.
# Public URL of this API; the OAuth callback is <API_PUBLIC_URL>/api/auth/oauth/<provider>/callback
API_PUBLIC_URL=http://localhost:5001
# GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI (spec §9) -----------------------------------------------------------
# AI_PROVIDER=fake gives deterministic placeholder answers without an API key (local dev only).
AI_ENABLED=true
# openai | fake
AI_PROVIDER=fake
OPENAI_API_KEY=
# VERIFY the exact API model id before use
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_TIMEOUT_SECONDS=60
AI_MODEL_LABEL=GPT-6
# {"<model-id>":{"input_per_1m":0,"cached_input_per_1m":0,"output_per_1m":0}}
AI_PRICING_JSON={}
AI_DAILY_TOKEN_LIMIT=200000
AI_DAILY_GENERATION_LIMIT=30
AI_MONTHLY_BUDGET_USD=100
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS_CHAT=2000
AI_MAX_OUTPUT_TOKENS_GENERATION=4000

# --- Integrations -------------------------------------------------------------
# fine-grained PAT, public read-only (raises limit 60 -> 5000/h)
GITHUB_TOKEN=

# --- Infra --------------------------------------------------------------------
# redis://localhost:6380/0 to use the docker-compose Redis
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
# 1 behind App Runner / a single proxy
TRUST_PROXY_HOPS=0
JOB_SECRET=change-me-to-64-random-characters-change-me-to-64-random-characters
SENTRY_DSN=
LOG_LEVEL=INFO
